{
 "id": "2026-10-08-ondupet-e2e",
 "titulo": "Análisis E2E de Ondupet",
 "datos": {
  "notas": {
   "OPET": {
    "1.1": {
     "estado": "propio",
     "herramienta": "SAP",
     "frecuencia": "Bajo demanda (alta de material nuevo)",
     "situacion": "Monica Gordillo crea los materiales: como es de Comercial, es quien antes se entera de que hace falta uno. Consulta con Calidad las características técnicas, pero no pregunta a Planificación qué estrategia debe llevar.",
     "problemas": "Planificación no participa en el alta: el material llega sin estrategia (MTS/MTO, ABC) ni ruta revisada. Duda abierta: ¿se consulta a Producción y Mantenimiento la ruta por defecto?",
     "propuesta": "Alta con plantilla única: Comercial lo solicita, Calidad fija las características y Dato maestro asigna estrategia y ruta consultando a Planificación y Producción. Antes de crear, se comprueba que no haya duplicados."
    },
    "1.2": {
     "quien": "Nadie",
     "herramienta": "Transacción de cálculo automático de ABC y estrategias (sin uso)"
    },
    "1.3": {
     "estado": "propio",
     "herramienta": "SAP (dato del molde)",
     "frecuencia": "Solo al dar de alta; las rutas no se revisan",
     "situacion": "Las velocidades y los tiempos de cambio dependen del molde, que es un dato fijo del dato maestro. Por eso necesitan mucho menos mantenimiento que en otras plantas.",
     "problemas": "Las rutas no se actualizan con la carga de capacidad del mes, así que la carga entre máquinas no se equilibra.",
     "propuesta": "Cada mes, Programación revisa las rutas por defecto con la carga del mes, consultando a Producción. Velocidades y tiempos de cambio se revisan solo si cambia el molde o hay desviaciones frente a lo real.",
     "prioridad": "Media"
    },
    "1.5": {
     "estado": "nohace",
     "quien": "Nadie (correcciones puntuales de Monica Gordillo y su equipo)",
     "herramienta": "SAP · campo «material reemplazante»",
     "frecuencia": "Nunca; solo correcciones puntuales",
     "situacion": "No hay auditoría ni estándar para detectar duplicados, porque no está claro qué características definen un material. Cuando Monica o alguien de su equipo encuentra uno, lo corrige con el campo «material reemplazante», que une el duplicado con el material definitivo sin perder el histórico de ventas ni de producción.",
     "problemas": "Los duplicados se encuentran por casualidad: no hay análisis del dato maestro ni un criterio de qué define un material.",
     "propuesta": "Definir qué características identifican un material y hacer una auditoría mensual (duplicados, datos incompletos e incoherencias) con su KPI. Se sigue usando «material reemplazante» para unir materiales sin perder histórico.",
     "prioridad": "Media"
    },
    "2.1": {
     "estado": "propio",
     "quien": "Manuel Jesus Trinidad",
     "frecuencia": "Mensual, sin día de cierre",
     "situacion": "Cada mes, Manuel Jesus Trinidad carga la previsión de cada material: como mínimo, el mes en curso y los tres siguientes.",
     "problemas": "No hay día límite para cerrar la previsión. La del mes en curso se cambia sin consultar a Planificación, incluso cuando el material ya está fabricado (no debería estar permitido).",
     "propuesta": "Calendario mensual con día límite de cierre: Planificación propone la previsión estadística y Comercial la ajusta. Después del cierre, el mes en curso queda congelado y cualquier cambio necesita la aprobación de Planificación.",
     "prioridad": "Alta"
    },
    "2.2": {
     "estado": "nohace",
     "quien": "Nadie",
     "frecuencia": "Nunca",
     "situacion": "No hay un estándar para que Planificación y Comercial se pongan de acuerdo en qué se va a fabricar. Planificación fabrica lo que diga la previsión (descontando stock, órdenes lanzadas…) y con ella genera los temporales.",
     "problemas": "No hay plan de demanda acordado: si la previsión es mala, lo son también lo fabricado y los plazos que se dan.",
     "propuesta": "Reunión mensual de consenso (Comercial, Planificación y S&OP) tras cerrar la previsión, que incluya la revisión de temporales (2.5). Si no hay acuerdo, decide S&OP.",
     "prioridad": "Alta"
    },
    "2.3": {
     "estado": "informal",
     "quien": "Monica Gordillo y su equipo",
     "frecuencia": "Irregular",
     "situacion": "Se va de un extremo a otro: épocas con muchos agotados registrados y 2-3 meses sin registrar ninguno, aunque haya roturas.",
     "problemas": "No está claro qué es un agotado, así que el dato no sirve para corregir la previsión.",
     "propuesta": "Definir qué es un agotado (pedido no servido o rechazado por falta de stock o de plazo), registrarlo a diario con un motivo codificado y revisarlo en el ciclo mensual de previsión.",
     "prioridad": "Media"
    },
    "2.4": {
     "estado": "informal",
     "quien": "Manuel Jesus Trinidad y Victoriano Perez",
     "frecuencia": "Reunión mensual",
     "situacion": "Hay una reunión mensual de accuracy entre Manuel Jesus Trinidad y Victoriano Perez, pero Comercial no se implica y Planificación no la impulsa.",
     "problemas": "Se ven desviaciones enormes en algunos materiales y no se hace nada.",
     "propuesta": "KPI mensual de precisión y sesgo por familia y material. Los diez peores se ven en la reunión de consenso y cada desviación tiene responsable y acción, que se revisa al mes siguiente.",
     "prioridad": "Media"
    },
    "ap_opet_temporales": {
     "estado": "informal",
     "quien": "Victoriano Perez",
     "frecuencia": "Mensual, sin revisión conjunta",
     "situacion": "Planificación genera los temporales (previsiones de fabricación) a partir de la previsión de Comercial. Sirven para reservar tiempo de cada familia en el ciclo y poder dar plazos en la consulta de plazos.",
     "problemas": "No se revisan con Comercial ni con un criterio común: si la previsión no es buena, los plazos que se dan tampoco.",
     "propuesta": "Revisión mensual de los temporales con la previsión ya consensuada, dentro de la reunión de consenso (2.2).",
     "prioridad": "Alta",
     "notas": "Del análisis E2E: falta decidir si es un apartado propio o forma parte de 2.2 (consenso de la previsión)."
    },
    "3.1": {
     "estado": "propio",
     "quien": "Monica Gordillo (Comercial) y Victoriano Perez (Planificación), por separado",
     "frecuencia": "Diaria",
     "situacion": "Cada día, Comercial y Planificación revisan por separado la cartera de pedidos, el stock disponible y las cargas, y lo ponen en común en la reunión de producción.",
     "problemas": "No hay acuerdo sobre las fechas de entrega de cargas y pedidos: aunque Planificación avise de que no llega a la fecha del cliente, no se cambia. Y eso que el pedido tiene dos fechas: la que pidió el cliente y otra para medir retrasos.",
     "propuesta": "Una sola revisión con una sola fuente de datos. Planificación confirma una fecha viable y Comercial la negocia con el cliente. Se usan las dos fechas del pedido: la solicitada para medir el servicio y la confirmada para planificar.",
     "prioridad": "Alta"
    },
    "3.2": {
     "estado": "propio",
     "quien": "Monica Gordillo y su equipo (Victoriano Perez envía el reporte de atrasos)",
     "frecuencia": "Diaria",
     "situacion": "Cada día, Monica y su equipo vinculan todas las cargas a sus pedidos. Planificación envía un reporte diario de cargas atrasadas.",
     "problemas": "A veces se crean cargas por mucha más cantidad que la del pedido y con fechas de entrega imposibles de cumplir.",
     "propuesta": "Al crear la carga, validar que la cantidad no supere lo pendiente del pedido y que la fecha sea la confirmada. El reporte de atrasos pasa a ser un KPI diario con su causa.",
     "prioridad": "Media"
    },
    "3.3": {
     "estado": "informal",
     "quien": "Monica Gordillo y su equipo",
     "frecuencia": "Sin pauta",
     "situacion": "Comercial salda los pedidos. Da la sensación de que algunos, ya planificados, se saldan sin avisar a Planificación.",
     "problemas": "Planificación puede seguir fabricando o reservando capacidad para pedidos que ya están cerrados.",
     "propuesta": "Saldado semanal con una regla común: Planificación propone qué pedidos saldar (completos o con un resto mínimo) y Comercial lo valida. Si se salda un pedido planificado, Planificación se entera en el momento.",
     "prioridad": "Media"
    },
    "3.4": {
     "estado": "informal",
     "quien": "Comercial (Monica Gordillo, Manuel Jesus Trinidad) y Victoriano Perez; decide Manuel Castro si no hay acuerdo",
     "frecuencia": "Bajo demanda (por teléfono)",
     "situacion": "Cuando hay varios pedidos comprometidos, Comercial (Monica y su equipo, o incluso Manuel Jesus) llama a Planificación para buscar soluciones. Si no se ponen de acuerdo, llaman a Manuel Castro (director de planta) para que decida.",
     "problemas": "No hay reglas de prioridad: se resuelve caso a caso por teléfono y acaba en el director de planta.",
     "propuesta": "Reglas de prioridad acordadas (tipo de cliente, fecha comprometida, margen y stock de seguridad) que aplica Planificación consultando a Comercial y Programación. Si afecta a otras plantas, decide S&OP. Al director de planta solo se le informa.",
     "prioridad": "Media"
    }
   }
